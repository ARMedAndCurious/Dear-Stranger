PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/dear-stranger
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional: without both values, advice is sent to owner review, never auto-approved.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=
# Optional: Gnani Prisma v3 REST speech-to-text
GNANI_API_KEY=
# Optional: Google Cloud Translation Basic API key
GOOGLE_TRANSLATE_API_KEY=
